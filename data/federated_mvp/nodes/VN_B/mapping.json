{
  "site": "VN_B",
  "fictional_site": true,
  "layout": "long",
  "source_system": "LEGACY_LIS",
  "delimiter": ",",
  "encoding": "utf-8",
  "decimal_separator": ".",
  "date_format": "%Y%m%d",
  "columns": {
    "patient_id": "pid",
    "encounter_id": "visit_id",
    "specimen_id": "sample_id",
    "date": "ts",
    "date_format": "ts_format",
    "revision": "ver",
    "status": "state"
  },
  "tests": {
    "0301": {
      "code": "HB",
      "export_unit": "g/L",
      "export_factor": "10",
      "canonical_unit": "g/dL",
      "accepted_units": {
        "g/L": "0.1"
      }
    },
    "0304": {
      "code": "MCV",
      "export_unit": "fL",
      "export_factor": "1",
      "canonical_unit": "fL",
      "accepted_units": {
        "fL": "1"
      }
    },
    "0305": {
      "code": "MCH",
      "export_unit": "pg",
      "export_factor": "1",
      "canonical_unit": "pg",
      "accepted_units": {
        "pg": "1"
      }
    },
    "0302": {
      "code": "RBC",
      "export_unit": "10^12/L",
      "export_factor": "1",
      "canonical_unit": "10^12/L",
      "accepted_units": {
        "10^12/L": "1"
      }
    },
    "0306": {
      "code": "MCHC",
      "export_unit": "g/dL",
      "export_factor": "1",
      "canonical_unit": "g/dL",
      "accepted_units": {
        "g/dL": "1"
      }
    },
    "0307": {
      "code": "RDW",
      "export_unit": "%",
      "export_factor": "1",
      "canonical_unit": "%",
      "accepted_units": {
        "%": "1"
      }
    },
    "H01": {
      "code": "HBA0",
      "export_unit": "fraction",
      "export_factor": "0.01",
      "canonical_unit": "%",
      "accepted_units": {
        "fraction": "100"
      }
    },
    "H02": {
      "code": "HBA2",
      "export_unit": "fraction",
      "export_factor": "0.01",
      "canonical_unit": "%",
      "accepted_units": {
        "fraction": "100"
      }
    },
    "H03": {
      "code": "HBF",
      "export_unit": "fraction",
      "export_factor": "0.01",
      "canonical_unit": "%",
      "accepted_units": {
        "fraction": "100"
      }
    }
  },
  "identity_rule": "Strip outer whitespace; join patient_id to registry.local_patient_id within this site only.",
  "revision_rule": "After re-export deduplication, latest final revision per specimen and test wins.",
  "date_rule": "Use declared DateFormat/ts_format/KieuNgay. Blank format is unknown and requires review.",
  "unit_assumption": "Canonical source units follow the demo dictionary; source units were not independently clinically validated.",
  "files": [
    "results.csv",
    "reexport.csv"
  ]
}
