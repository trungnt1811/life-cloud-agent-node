ENV=DEV
LOG_LEVEL=info

APP_NAME=life-cloud-agent-node
APP_PORT=8080
APP_REQUEST_TIMEOUT_MS=30000

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=life_cloud_agent_node
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_IN_MINUTE=60

CACHE_TYPE=in-memory
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_TTL=10m
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_POOL_TIMEOUT_MS=1000

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=Content-Type,Content-Length,Accept-Encoding,X-CSRF-Token,Authorization,accept,origin,Cache-Control,X-Requested-With,X-Request-ID,X-Correlation-ID
ENABLE_AUTO_MIGRATE=false
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=
# Required to register /admin/query-fields (never registered without both
# set; the process fails fast at startup if only one is set). Deliberately
# separate from SWAGGER_BASIC_AUTH_* so rotating docs access never also
# rotates the ability to change which clinical fields this node exposes.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=
# Small-cell suppression for QueryResult (process 3.6). When the raw match
# count is in (0, threshold) the node returns matching_count=0 with
# suppressed=true. Default 5. Fails closed: 0 (or unset) means the default,
# not "disabled".
SUPPRESSION_THRESHOLD=5
# Patients per resumable, checkpointed cohort chunk (decision 0005). Default
# 5000; below 1 means the default.
JOB_CHUNK_SIZE=5000

# Federated gRPC client (decisions 0001, 0006). CONTROL_CENTER_ADDRESS blank
# disables the client worker - no control center to dial yet is valid.
CONTROL_CENTER_ADDRESS=
NODE_ID=
AGENT_VERSION=dev
# TLS is required by default; only set this for local dev / the Phase 8 stub.
CONTROL_CENTER_INSECURE=false
CONTROL_CENTER_CA_FILE=
# Both or neither: presenting only one is a startup error.
CONTROL_CENTER_CLIENT_CERT_FILE=
CONTROL_CENTER_CLIENT_KEY_FILE=
